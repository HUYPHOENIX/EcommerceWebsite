@{
    ViewData["Title"] = "Success!";
}

<div class="container mt-5">
    <div class="row justify-content-center text-center">
        <div class="col-md-6">
            <div class="card shadow p-5">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                </div>
                <h1 class="display-5">Cảm ơn vì đã mua hàng!</h1>
                <p class="lead">Đơn hàng của bạn đã được đặt thành công.</p>
                
                <div class="bg-light p-3 rounded mb-4">
                    <h5 class="text-muted mb-1">Mã đơn hàng:</h5>
                    <h3 class="text-primary font-monospace">#@ViewBag.OrderId</h3>
                </div>

                <p class="text-muted">Email xác nhận sẽ được gửi đến bạn trong ít phút nữa.</p>
                
                <hr />
                
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-5">
                    Tiếp tục mua hàng
                </a>
            </div>
        </div>
    </div>
</div>