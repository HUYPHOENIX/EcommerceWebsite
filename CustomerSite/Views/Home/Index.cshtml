@using SharedViewModel.DTOs

@model SharedViewModel.DTOs.PagedItems<SharedViewModel.DTOs.ProductListDto>

@{
    ViewData["Title"] = "Trang chủ";
}

<div class="container py-4">

    <!-- HERO CAROUSEL -->
    <div id="heroCarousel"
         class="carousel slide rounded-4 overflow-hidden shadow"
         data-bs-ride="carousel">

        <div class="carousel-inner">

            <div class="carousel-item active">
                <img src="~/images/banner1.jpg"
                     class="d-block w-100"
                     style="height:550px; object-fit:cover;"
                     alt="Summer Collection">

                <div class="carousel-caption text-start mb-5 d-none d-md-block">
                    <h1 class="display-3 fw-bold">
                        BST Mùa Hè 2026
                    </h1>

                    <p class="fs-4">
                        Giảm giá lên đến 50% cho tất cả sản phẩm.
                    </p>

                    <a href="/Products"
                       class="btn btn-dark btn-lg rounded-pill px-5">
                        Mua ngay
                    </a>
                </div>
            </div>

            <div class="carousel-item">
                <img src="~/images/banner2.jpg"
                     class="d-block w-100"
                     style="height:550px; object-fit:cover;"
                     alt="New Arrivals">

                <div class="carousel-caption d-none d-md-block">
                    <h1 class="display-3 fw-bold">
                        Hàng Mới Về
                    </h1>

                    <p class="fs-4">
                        Phong cách tối giản cho người hiện đại.
                    </p>

                    <a href="/Products"
                       class="btn btn-light btn-lg rounded-pill px-5">
                        Khám phá
                    </a>
                </div>
            </div>

            <div class="carousel-item">
                <img src="~/images/banner3.jpg"
                     class="d-block w-100"
                     style="height:550px; object-fit:cover;"
                     alt="Luxury">

                <div class="carousel-caption d-none d-md-block">
                    <h1 class="display-3 fw-bold">
                        Lịch lãm và thời thượng
                    </h1>

                    <p class="fs-4">
                        Lựa chọn của những người đàn ông nam tính.
                    </p>

                    <a href="/Products"
                       class="btn btn-light btn-lg rounded-pill px-5">
                        Khám phá
                    </a>
                </div>
            </div>

        </div>

        <button class="carousel-control-prev"
                type="button"
                data-bs-target="#heroCarousel"
                data-bs-slide="prev">

            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next"
                type="button"
                data-bs-target="#heroCarousel"
                data-bs-slide="next">

            <span class="carousel-control-next-icon"></span>
        </button>
    </div>

    <!-- PRODUCTS -->
    <div class="mt-5 mb-5">

        <div class="d-flex justify-content-between align-items-end mb-4">

            <div>
                <h2 class="fw-bold mb-0">
                    Sản phẩm nổi bật
                </h2>

                <p class="text-muted">
                    Được lựa chọn nhiều nhất trong tuần qua
                </p>
            </div>

            <a href="/Products"
               class="text-dark fw-bold text-decoration-none border-bottom border-dark">
                Xem tất cả
            </a>

        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">

            @foreach (var item in Model.Items)
            {
                <div class="col">

                    <div class="card h-100 border-0 shadow-sm rounded-4">

                        <img src="~/images/product.jpg"
                             class="card-img-top"
                             style="height:320px; object-fit:cover;"
                             alt="@item.Name">

                        <div class="card-body d-flex flex-column text-center">

                            <h5 class="card-title text-truncate">
                                @item.Name
                            </h5>

                            <p class="text-danger fw-bold fs-5">
                                @item.Price
                            </p>

                            <div class="mt-auto">

                                <a asp-controller="Products"
                                   asp-action="Detail"
                                   asp-route-id="@item.Id"
                                   class="btn btn-outline-dark rounded-pill w-100">

                                    Mua ngay
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</div>

<!-- NEWSLETTER -->
<div class="bg-light py-5 mt-5">

    <div class="container text-center">

        <h3 class="fw-bold">
            Đừng bỏ lỡ ưu đãi!
        </h3>

        <p class="text-muted">
            Nhận thông báo về bộ sưu tập mới và các chương trình khuyến mãi sớm nhất.
        </p>

        <div class="row justify-content-center mt-4">

            <div class="col-md-6">

                <div class="input-group">

                    <input type="email"
                           class="form-control rounded-start-pill px-4"
                           placeholder="Nhập email của bạn...">

                    <button class="btn btn-dark rounded-end-pill px-4">
                        Đăng ký
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>