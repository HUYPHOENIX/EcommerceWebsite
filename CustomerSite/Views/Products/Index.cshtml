@model SharedViewModel.DTOs.PagedItems<SharedViewModel.DTOs.ProductDto>

@{
    ViewData["Title"] = "Our Products";
    // Grab the current category so we remember it when clicking "Next Page"
    var currentCategory = ViewBag.CurrentCategory as int?;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0">Danh sách sản phẩm</h2>
    </div>

    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom">
                    <h5 class="fw-bold mb-0">Loại sản phẩm</h5>
                </div>
                <div class="list-group list-group-flush">
                    <a asp-action="Index" asp-route-categoryId="" asp-route-page="1" 
                       class="list-group-item list-group-item-action @(currentCategory == null ? "active fw-bold" : "")">
                        Tất cả sản phẩm
                    </a>
                    
                    <a asp-action="Index" asp-route-categoryId="1" asp-route-page="1"
                       class="list-group-item list-group-item-action @(currentCategory == 1 ? "active fw-bold" : "")">1</a>
                       
                    <a asp-action="Index" asp-route-categoryId="2" asp-route-page="1"
                       class="list-group-item list-group-item-action @(currentCategory == 2 ? "active fw-bold" : "")">2</a>
                       
                    <a asp-action="Index" asp-route-categoryId="3" asp-route-page="1"
                       class="list-group-item list-group-item-action @(currentCategory == 3 ? "active fw-bold" : "")">3</a>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            
            @if (!Model.Items.Any())
            {
                <div class="alert alert-info text-center py-5 shadow-sm border-0">
                    <h4>Không có bất kì sản phẩm nào.</h4>
                    <p>Thử chọn lại loại sản phẩm khác hoặc chọn tất cả loại sản phẩm.</p>
                </div>
            }

            <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                @foreach (var product in Model.Items)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" class="card-img-top" alt="@product.Name" style="height: 220px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 220px;">
                                    <span class="text-muted"><i class="bi bi-image fs-1"></i></span>
                                </div>
                            }

                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title fw-bold text-truncate mb-1">@product.Name</h6>
                                <h6 class="text-primary mb-2">@product.Price.ToString("C")</h6>
                                
                                <div class="mt-auto pt-3">
                                    <a asp-controller="Products" asp-action="Detail" asp-route-id="@product.Id" class="btn btn-outline-dark w-100 btn-sm">
                                        Mua hàng
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-5 d-flex justify-content-center">
                    <ul class="pagination shadow-sm">
                        
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-categoryId="@currentCategory" 
                               asp-route-page="@(Model.PageNumber - 1)">
                                &laquo; Trở về
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link" asp-action="Index" 
                                   asp-route-categoryId="@currentCategory" 
                                   asp-route-page="@i">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" 
                               asp-route-categoryId="@currentCategory" 
                               asp-route-page="@(Model.PageNumber + 1)">
                                Tiếp theo &raquo;
                            </a>
                        </li>
                        
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>